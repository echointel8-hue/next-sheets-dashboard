# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง — .env.local ต้องไม่ถูก commit
# (เช็คว่าอยู่ใน .gitignore แล้ว)

# --- อ่าน/เขียน Google Sheets (จำเป็น) ---
# Service account ต้องถูกแชร์บนสเปรดชีตเป็นสิทธิ์ Editor (ไม่ใช่แค่ Viewer)
# เพราะหน้า "จัดการข้อมูล" เขียนข้อมูลกลับเข้าไปในชีต (แก้ไข/เพิ่ม/จำหน่าย/จัดการผู้ใช้)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
# ชื่อแท็บที่เก็บข้อมูลครุภัณฑ์ (ค่าเริ่มต้น: Sheet1 ถ้าไม่ตั้ง)
GOOGLE_SHEET_TAB=

# --- ทางเลือก: ล็อกหน้าเว็บทั้งหมดด้วย HTTP Basic Auth ---
# ไม่ตั้งค่า = ไม่มีการล็อกอินชั้นนี้ (ดู src/proxy.ts) — แยกต่างหากจากระบบ login
# ของหน้า /manage ด้านล่าง ใช้ร่วมกันได้ถ้าต้องการล็อกทั้งเว็บเพิ่มอีกชั้น
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# --- ระบบ login หน้า "จัดการข้อมูล" /manage และ /manage/users (จำเป็น) ---
# ดูรายละเอียดการเตรียม Google Sheet (แท็บ Users, คอลัมน์สถานะ, แท็บ EditLog) ใน README.md

# สตริงสุ่มยาวๆ (แนะนำ 32+ ตัวอักษร) ใช้เซ็นชื่อ session cookie หลัง login
# ห้ามใช้ค่าเดียวกับโปรเจกต์อื่น และห้ามหลุดออกไปนอกเครื่องนี้
# สร้างได้ด้วยเช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EDIT_SESSION_SECRET=

# บัญชี superadmin สำรอง ใช้ login ครั้งแรกตอนแท็บ Users ในชีตยังว่างเปล่า (แก้ปัญหาไก่-ไข่:
# ต้อง login ก่อนถึงจะสร้างบัญชีจริงผ่านหน้าเว็บได้) — ไม่ขึ้นกับแท็บ Users เลย ใช้ได้เสมอ
# PASSWORD_HASH ต้องเป็นรูปแบบ "<saltHex>:<hashHex>" (scrypt) สร้างได้ด้วย:
#   node -e "const c=require('crypto');const s=c.randomBytes(16);const h=c.scryptSync(process.argv[1],s,64);console.log(s.toString('hex')+':'+h.toString('hex'))" "รหัสผ่านที่ต้องการ"
BOOTSTRAP_SUPERADMIN_USERNAME=
BOOTSTRAP_SUPERADMIN_PASSWORD_HASH=

# ชื่อแท็บที่เก็บบัญชีผู้ใช้ (ค่าเริ่มต้น: Users ถ้าไม่ตั้ง)
GOOGLE_SHEET_USERS_TAB=

# ชื่อแท็บสำหรับบันทึก audit log (ค่าเริ่มต้น: EditLog ถ้าไม่ตั้ง)
# ต้องสร้างแท็บนี้เองในสเปรดชีตล่วงหน้า พร้อม header แถวแรก:
#   เวลา | การกระทำ | ผู้ทำรายการ | กลุ่มงาน | แถวที่ | คอลัมน์ | ค่าเดิม | ค่าใหม่
GOOGLE_SHEET_EDIT_LOG_TAB=
